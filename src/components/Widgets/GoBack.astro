---
import GoBackIcon from '@/assets/icons/go-back.svg';
---

<button
  id="back-button"
  class="hidden"
  lg="block absolute c-secondary/40 left--10 top-1/2 aspect-square w-4.5 translate-y--1/2 transition-colors ease-out c-secondary active:scale-90 hover:c-primary/80"
  aria-label="Back to home"
>
  <GoBackIcon
    aria-hidden="true"
    fill="currentColor"
  />
</button>

<!-- Go Back Script >>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>> -->
<script>
document.addEventListener('click', (e) => {
  const target = e.target as HTMLElement
  const backButton = target?.closest('#back-button')
  if (backButton) {
    if (window.history.length > 1) {
      window.history.back()
    }
    else {
      const titleLink = document.getElementById('site-title-link')
      titleLink?.click()
    }
  }
})
</script>
